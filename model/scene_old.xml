    <!-- COMPILER                                                     -->
    <!-- ============================================================ -->

    <compiler
        angle="degree"
        meshdir="../meshes"
        autolimits="true"
    />


    <!-- ============================================================ -->
    <!-- PHYSICS                                                      -->
    <!-- ============================================================ -->

    <option
        timestep="0.0002"
        integrator="implicitfast"
        solver="Newton"
        iterations="100"
        tolerance="1e-10"
        gravity="0 0 -9.81"
    />


    <!-- ============================================================ -->
    <!-- VISUAL                                                       -->
    <!-- ============================================================ -->

