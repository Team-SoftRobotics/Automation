    <!-- ASSETS                                                       -->
    <!-- ============================================================ -->

    <asset>

        <!--
            Actual CAD disc.

            STL dimensions:
                approximately 10 mm × 10 mm × 4 mm

            STL is therefore converted:
                millimetres -> metres
        -->

        <mesh
            name="disc_mesh"
            file="disc.stl"
            scale="0.001 0.001 0.001"
        />

    </asset>


